<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Modernised to an SDK-style net10.0 library, retiring mono / .NET Framework.

    The GDI+/WinForms graphics layer (Bitmap, Graphics, System.Windows.Forms) is
    temporarily excluded pending a SkiaSharp/Avalonia port; the headless text
    path (RawConsoleScreenMode and the text screen modes) runs cross-platform.
    The Color/Point/Size primitives the kept code uses live in
    System.Drawing.Primitives, which is part of the shared framework and is
    cross-platform, so no GDI+ package reference is needed.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OwlRuntime</RootNamespace>
    <AssemblyName>OwlRuntime</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Copy NuGet dependencies (SkiaSharp + its native library) into the build
         output, so a compiled program can run with the runtime beside it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2-D rendering for the graphics screen modes: windowless PNG capture
         first, an interactive window host later. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- The SkiaSharp metapackage bundles native libraries for Windows and
         macOS only; Linux needs its native asset added explicitly, or
         libSkiaSharp fails to load there (e.g. on CI runners). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- GDI+/WinForms graphics layer: excluded until the SkiaSharp/Avalonia port. -->
    <Compile Remove="platform/riscos/AcornFont.cs" />
    <Compile Remove="platform/riscos/BaseGraphicsScreenMode.cs" />
    <Compile Remove="platform/riscos/PalettedGraphicsScreenMode.cs" />
    <Compile Remove="platform/riscos/TrueGraphicsScreenMode.cs" />
    <Compile Remove="platform/riscos/VduForm.cs" />
    <EmbeddedResource Remove="platform/riscos/VduForm.resx" />

    <!-- Legacy embedded NUnit tests: superseded by a separate modern test project. -->
    <Compile Remove="BasicCommandsTest.cs" />
    <Compile Remove="platform/riscos/VduSystemTest.cs" />
  </ItemGroup>

</Project>
