DIM a(2)
FOR i%=0 TO 2 : a(i%)=10*(i%+1) : NEXT
PRINT "before:";
FOR i%=0 TO 2 : PRINT " ";STR$(a(i%)); : NEXT : PRINT
dummy = FNpoke(99)
PRINT "after: ";
FOR i%=0 TO 2 : PRINT " ";STR$(a(i%)); : NEXT : PRINT
END
DEF FNpoke(a(1))
PRINT "inside:";
FOR i%=0 TO 2 : PRINT " ";STR$(a(i%)); : NEXT : PRINT
= 0
